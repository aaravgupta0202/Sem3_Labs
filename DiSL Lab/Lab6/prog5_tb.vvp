#! /usr/bin/vvp
:ivl_version "11.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 9;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x55e1484d3b00 .scope module, "prog5_tb" "prog5_tb" 2 4;
 .timescale -9 -9;
v0x55e1484fa010_0 .var "A", 15 0;
v0x55e1484fa100_0 .net "Y", 3 0, v0x55e1484afc00_0;  1 drivers
S_0x55e1484e7d40 .scope module, "ex1" "encoder16to4" 2 9, 3 1 0, S_0x55e1484d3b00;
 .timescale -9 -9;
    .port_info 0 /INPUT 16 "A";
    .port_info 1 /OUTPUT 4 "Y";
v0x55e1484af7f0_0 .net "A", 15 0, v0x55e1484fa010_0;  1 drivers
v0x55e1484afc00_0 .var "Y", 3 0;
v0x55e1484f9ef0_0 .var/i "i", 31 0;
E_0x55e1484ae520 .event edge, v0x55e1484af7f0_0;
    .scope S_0x55e1484e7d40;
T_0 ;
    %wait E_0x55e1484ae520;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x55e1484afc00_0, 0, 4;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x55e1484f9ef0_0, 0, 32;
T_0.0 ;
    %load/vec4 v0x55e1484f9ef0_0;
    %cmpi/s 16, 0, 32;
    %jmp/0xz T_0.1, 5;
    %load/vec4 v0x55e1484af7f0_0;
    %load/vec4 v0x55e1484f9ef0_0;
    %part/s 1;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x55e1484f9ef0_0;
    %pad/s 4;
    %store/vec4 v0x55e1484afc00_0, 0, 4;
T_0.2 ;
    %load/vec4 v0x55e1484f9ef0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x55e1484f9ef0_0, 0, 32;
    %jmp T_0.0;
T_0.1 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x55e1484d3b00;
T_1 ;
    %vpi_call 2 13 "$dumpfile", "prog5_tb.vcd" {0 0 0};
    %vpi_call 2 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55e1484d3b00 {0 0 0};
    %pushi/vec4 1, 0, 16;
    %store/vec4 v0x55e1484fa010_0, 0, 16;
    %delay 20, 0;
    %pushi/vec4 2, 0, 16;
    %store/vec4 v0x55e1484fa010_0, 0, 16;
    %delay 20, 0;
    %pushi/vec4 4, 0, 16;
    %store/vec4 v0x55e1484fa010_0, 0, 16;
    %delay 20, 0;
    %pushi/vec4 128, 0, 16;
    %store/vec4 v0x55e1484fa010_0, 0, 16;
    %delay 20, 0;
    %pushi/vec4 4096, 0, 16;
    %store/vec4 v0x55e1484fa010_0, 0, 16;
    %delay 20, 0;
    %pushi/vec4 32768, 0, 16;
    %store/vec4 v0x55e1484fa010_0, 0, 16;
    %delay 20, 0;
    %pushi/vec4 45061, 0, 16;
    %store/vec4 v0x55e1484fa010_0, 0, 16;
    %delay 20, 0;
    %vpi_call 2 31 "$display", "Test Complete" {0 0 0};
    %end;
    .thread T_1;
